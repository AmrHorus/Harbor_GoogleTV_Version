<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.Harbor" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/harbor_primary</item>
        <item name="android:colorPrimaryDark">@color/harbor_primary_dark</item>
        <item name="android:colorAccent">@color/harbor_primary</item>
        <item name="android:windowBackground">@color/harbor_background</item>
        <item name="android:navigationBarColor">@color/harbor_background</item>
        <item name="android:statusBarColor">@color/harbor_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <!-- TV Theme - extends base theme with TV-specific styling -->
    <style name="Theme.Harbor.TV" parent="Theme.Harbor">
        <item name="android:windowBackground">@color/harbor_background</item>
    </style>
</resources>
