<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.Zizi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/zizi_primary</item>
        <item name="android:colorPrimaryDark">@color/zizi_primary_dark</item>
        <item name="android:colorAccent">@color/zizi_primary</item>
        <item name="android:windowBackground">@color/zizi_background</item>
        <item name="android:navigationBarColor">@color/zizi_background</item>
        <item name="android:statusBarColor">@color/zizi_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>
    
    <!-- TV Theme - extends base theme with TV-specific styling -->
    <style name="Theme.Zizi.TV" parent="Theme.Zizi">
        <item name="android:windowBackground">@color/zizi_background</item>
    </style>
</resources>
